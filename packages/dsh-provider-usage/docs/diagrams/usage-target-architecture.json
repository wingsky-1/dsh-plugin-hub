  "cards": [
    {
      "dot": "cyan",
      "title": "外部边界",
      "items": [
        "浏览器客户端：HTTP 拉取 + 宿主 HTML 注入，不 import 宿主",
        "用户自定义适配器：宿主全权限信任域，三函数 v2 契约",
        "远端 API：仅经适配器 fetch，密钥不出宿主"
      ]
    },
    {
      "dot": "violet",
      "title": "宿主进程边界",
      "items": [
        "域1 + 域2 + 装配层，两域业务面零直接依赖",
        "共享底座 charts/config/sanitize 被两域消费",
        "16 路由 loopback 围栏（403/405）"
      ]
    },
    {
      "dot": "amber",
      "title": "修订落地 R1-R5",
      "items": [
        "R2：路由层与客户端进程分离建模",
        "R4：路由直连服务对象（cache/registry）如实标注",
        "R5：reportCfg 闭包双源 / 模块级缓存入模型"
      ]
    },
    {
      "dot": "rose",
      "title": "信任与安全",
      "items": [
        "用户适配器 = 宿主全权限（文档化信任域）",
        "HTML 双层净化（esc + sanitize）",
        "密钥仅宿主内存 · loopback-only"
      ]
    }
  ]
