{
  "name": "@wingsky-1/dsh-skill-explorer",
  "version": "0.1.1",
  "description": "DSH Web GUI 技能中心：侧边栏入口 + 面板，分级展示已加载 skill（系统内置/项目/用户/自定义/运行时），支持创建、启用/禁用与删除（移入 .trash）。数据以文件系统扫描为主 + ctx.skills 注册表补充。",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "node ../../scripts/clean-lib.mjs && tsc -p tsconfig.json && node ../../scripts/bundle-host.mjs .",
    "test": "node test/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run build && pnpm test"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "shared/*.d.ts",
    "types/dsh.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wingsky-1/dsh-plugin-hub.git",
    "directory": "packages/dsh-skill-explorer"
  },
  "bugs": {
    "url": "https://github.com/wingsky-1/dsh-plugin-hub/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skill"
  ],
  "author": "wingsky-1",
  "publishConfig": {
    "access": "public"
  }
}