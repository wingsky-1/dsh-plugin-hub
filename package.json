{
  "name": "dsh-plugin-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DSH（DeepSeek Harness）Web GUI 插件集：通知、provider 用量、局域网代理、MCP 管理、闲置归档、文件预览——一键装全家桶或按需单装",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --filter !dsh-plugin-hub build",
    "test": "pnpm -r --filter !dsh-plugin-hub test",
    "test:contract": "vitest run --project contract",
    "contract": "node scripts/gate/contract-check.ts",
    "catalog:sync-peers": "node scripts/maintenance/sync-catalog-peers.ts",
    "pack:check": "node scripts/gate/pack-check.ts",
    "verify:npmlayout": "node scripts/gate/verify-npm-layout.ts",
    "aggregate:check": "node scripts/gate/aggregate.ts --check",
    "stryker:gen": "node scripts/gate/gen-stryker-conf.mjs",
    "stryker:check": "node scripts/gate/gen-stryker-conf.mjs --check",
    "test:scripts": "node --test scripts/test/*.test.ts",
    "repair:mcp-catalog": "node scripts/maintenance/repair-mcp-catalog-sessions.mjs",
    "test:src-tests": "node scripts/gate/forbid-src-tests.mjs",
    "gate:homedir": "node scripts/gate/forbid-homedir-src.mjs",
    "gate:module-state": "node scripts/gate/forbid-module-state-src.mjs",
    "verify:scripts-index": "node scripts/gate/verify-scripts-index.mjs",
    "verify:coverage-scope": "node scripts/gate/verify-coverage-scope.mjs",
    "verify:prose-counts": "node scripts/gate/verify-prose-counts.mjs",
    "verify:vendored-binaries": "node scripts/gate/verify-vendored-binaries.mjs",
    "docs:check": "node scripts/gate/verify-docs.ts --strict-en",
    "typecheck": "pnpm -r --if-present run typecheck",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "gate:changed": "node scripts/gate/local-gate.mjs --tier changed",
    "gate:pr": "node scripts/gate/local-gate.mjs --tier pr",
    "gate:full": "node scripts/gate/local-gate.mjs --tier full",
    "cov": "vitest run --coverage --project unit --project integration --project client-unit --project client-dom",
    "crap": "node scripts/gate/crap-check.mjs",
    "lint": "node tools/lint/bin/lint.mjs",
    "prepare": "lefthook install",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin"
  ],
  "packageManager": "pnpm@11.21.0",
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,mjs,cjs}": [
      "prettier --write",
      "node tools/lint/bin/lint.mjs"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-istanbul": "4.1.11",
    "acorn": "^8.18.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.3",
    "isbinaryfile": "^6.0.0",
    "lefthook": "2.1.12",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "4.1.11",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=23.6"
  }
}
