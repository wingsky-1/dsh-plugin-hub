{
  "name": "dsh-plugin-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DSH（DeepSeek Harness）插件集：npm 分发，可一键装全家桶（@wingsky-1/dsh-plugins-all）或单独安装（@wingsky-1/dsh-*）",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "contract": "node scripts/contract-check.ts",
    "pack:check": "node scripts/pack-check.ts",
    "verify:npmlayout": "node scripts/verify-npm-layout.ts",
    "aggregate:check": "node scripts/aggregate.ts --check",
    "test:scripts": "node --test scripts/*.test.ts",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin"
  ],
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=23.6"
  }
}