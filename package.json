{
  "name": "dsh-plugin-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DSH（DeepSeek Harness）Web GUI 插件集：通知、provider 用量、局域网代理、MCP 管理、闲置归档、文件预览——一键装全家桶或按需单装",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "contract": "node scripts/contract-check.ts",
    "pack:check": "node scripts/pack-check.ts",
    "verify:npmlayout": "node scripts/verify-npm-layout.ts",
    "aggregate:check": "node scripts/aggregate.ts --check",
    "test:scripts": "node --test scripts/*.test.ts",
    "docs:check": "node scripts/verify-docs.ts",
    "typecheck": "pnpm -r --if-present run typecheck",
    "cov": "c8 --reporter=json --reporter=json-summary --reporter=text pnpm -r --if-present test",
    "crap": "node scripts/crap-check.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin"
  ],
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.2.0",
    "acorn": "^8.18.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "selfsigned": "^2.4.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=23.6"
  }
}