{
  "name": "dsh-plugin-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DSH（DeepSeek Harness）插件集：npm 分发，可一键装全家桶（@wingsky/dsh-plugins-all）或单独安装（@wingsky/dsh-*）",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "contract": "node scripts/contract-check.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "keywords": ["dsh", "deepseek-harness", "plugin"],
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0"
  }
}
