{
  // 入面口径（#776 批 3「开面」）：scripts/ 非 test 全树（build/ gate/ lib/ release/）入面。
  // 用 glob 而非逐项枚举：枚举清单在新增脚本时会静默漏面，glob 让「新增即入面」成为
  // 默认，漏面只能由显式 exclude 造成，而任何 exclude 都被
  // scripts/test/verify-docs-typecheck.test.ts 的「磁盘集合 - 程序集合」对账断言逮住。
  // scripts/test/** 仍排除：本批不摘 test 侧 @ts-nocheck，纳入会引入其类型错误（后续独立批次）。
  //
  // 为什么必须有程序覆盖断言：tsc 对「include/exclude 漏掉某个文件」静默绿（只有 include
  // 全空才配置级报错），故在面文件靠测试里的程序集对账兜底，而非靠 include 文本正则。
  // 守卫三条判据（scripts/test/verify-docs-typecheck.test.ts）：面外文件必须全部落在
  // scripts/test/ 下（非 test 脚本被移出覆盖即红）；本文件 exclude 集合恒等于
  // EXPECTED_EXCLUDE_SET；面外集合非空（防 exclude 清空后判据恒真）。
  // 收敛排除面（例如 test 侧补齐后删掉 test/**）必须同步更新该测试的 EXPECTED_EXCLUDE_SET。
  //
  // #474 R2（保留）：显式覆写 module 语义——scripts/ 无 package.json，module 语义依赖根
  // type:module 向上回溯（运气依赖，未来 scripts/ 放 package.json 或 base 改动即整面翻红），
  // 此处显式固化防漂移。
  // allowImportingTsExtensions：scripts/ 下 26 处相对 import 写全 .ts 后缀（Node 直接执行
  // TS 的运行时要求），不开则该选项语义下摘 @ts-nocheck 时立刻 TS5097 翻红；实测开启后
  // 本半区 0 新增 error（noEmit=true 满足该选项前置条件）。
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.cts"],
  // 显式 exclude 会替换 tsc 的内置排除集（node_modules / bower_components / jspm_packages /
  // outDir），故把内置项一并列出，避免未来 scripts/ 出现同名目录时被意外拉入面内。
  "exclude": ["test/**", "node_modules/**", "bower_components/**", "jspm_packages/**"]
}
