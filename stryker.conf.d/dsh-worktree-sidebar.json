{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-worktree-sidebar/src/**/*.ts"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": []
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-worktree-sidebar.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-worktree-sidebar.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-worktree-sidebar.json",
  "_comment": "#847：src/**/*.ts 单段覆盖宿主与客户端，无文件排除；通过 enableMutations 撤销共享默认的四类字面量排除，本包有效算子排除集合为空。incremental 基线随 observe 夜间全量班重建。"
}
