{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-notifier/src/server/upgrade/**/*.ts",
    "!packages/dsh-notifier/src/client/**",
    "!packages/dsh-notifier/src/**/interface.ts",
    "!packages/dsh-notifier/src/server/*/deps.ts",
    "!packages/dsh-notifier/src/server/channels/impl/system/deps.ts",
    "!packages/dsh-notifier/src/**/*.d.ts",
    "!packages/dsh-notifier/src/**/*.ps1"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-notifier-upgrade.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-notifier-upgrade.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-notifier-upgrade.json",
  "_comment": "#733 按域重写：upgrade——存量迁移域（version 版本戳；chain 迁移链；legacy 旧位置读取；steps.storage-layout 存储布局搬迁）。"
}
