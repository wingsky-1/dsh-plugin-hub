{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-notifier/src/server/pipeline/**/*.ts",
    "!packages/dsh-notifier/src/client/**",
    "!packages/dsh-notifier/src/**/interface.ts",
    "!packages/dsh-notifier/src/server/*/deps.ts",
    "!packages/dsh-notifier/src/server/channels/impl/system/deps.ts",
    "!packages/dsh-notifier/src/**/*.d.ts",
    "!packages/dsh-notifier/src/**/*.ps1"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-notifier.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-notifier-pipeline.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-notifier-pipeline.json",
  "_comment": "#733 按域重写：pipeline——管线域（judge 三条裁决判据与抑制原因；route 目标解析与陈旧目标回收；finalize 严重度归一、标题截断与消息定稿；dispatch 重试/退避/节流/在途上限；service 编排与 kind 注册表）。重试状态机在本域是刻意的：出口保持无状态。"
}
