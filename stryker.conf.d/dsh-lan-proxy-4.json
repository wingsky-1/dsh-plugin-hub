{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-lan-proxy/src/settings.ts",
    "packages/dsh-lan-proxy/src/cert.ts",
    "packages/dsh-lan-proxy/src/index.ts",
    "!packages/dsh-lan-proxy/src/client/**",
    "!packages/dsh-lan-proxy/src/types.ts"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "testFiles": [
    "packages/dsh-lan-proxy/test/unit/unit-apply.test.ts",
    "packages/dsh-lan-proxy/test/unit/unit-proxy.test.ts"
  ],
  "vitest": {
    "related": false,
    "configFile": "vitest.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-lan-proxy-4.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-lan-proxy-4.json",
  "_comment": "#276 方案 A：src 级文件组分段（4）——mutate 为源文件名清单，密度均衡声明，无行号无漂移；测试全套跑（perTest 关联）；incremental 基线随 observe 四班次重建。"
}
