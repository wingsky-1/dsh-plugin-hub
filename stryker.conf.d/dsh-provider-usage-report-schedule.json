{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-provider-usage/src/domain2/schedule/config.ts",
    "packages/dsh-provider-usage/src/domain2/schedule/schedule.ts",
    "packages/dsh-provider-usage/src/domain2/schedule/scheduler.ts",
    "packages/dsh-provider-usage/src/domain2/schedule/tasks.ts",
    "packages/dsh-provider-usage/src/domain2/common/last-run.ts",
    "packages/dsh-provider-usage/src/apply/report-config-service.ts",
    "!packages/dsh-provider-usage/src/client/**",
    "!packages/dsh-provider-usage/src/types.ts",
    "!packages/dsh-provider-usage/src/**/interface.ts",
    "!packages/dsh-provider-usage/src/**/*.d.mts",
    "!packages/dsh-provider-usage/src/domain1/adapters/deepseek-official.mjs",
    "!packages/dsh-provider-usage/src/domain1/adapters/opencode-go.mjs",
    "!packages/dsh-provider-usage/src/domain1/adapters/zai-coding-cn.mjs",
    "!packages/dsh-provider-usage/src/shared/placement-math.ts"
  ],
  "testRunner": "tap",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/tap-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "tap": {
    "nodeArgs": [
      "-r",
      "./scripts/test/mutation-tap-bridge.cjs",
      "--import",
      "./scripts/test/mutation-lib-to-src-hook.mjs"
    ],
    "testFiles": [
      "packages/dsh-provider-usage/test/unit/adapters/unit-deepseek-official.test.ts",
      "packages/dsh-provider-usage/test/unit/apply/unit-apply.test.ts",
      "packages/dsh-provider-usage/test/unit/common/unit-errsurf.test.ts",
      "packages/dsh-provider-usage/test/unit/history/unit-history.test.ts",
      "packages/dsh-provider-usage/test/unit/pipeline/unit-signal-lock.test.ts",
      "packages/dsh-provider-usage/test/unit/pipeline/unit-stats-service.test.ts",
      "packages/dsh-provider-usage/test/unit/report/unit-report-executor.test.ts",
      "packages/dsh-provider-usage/test/unit/report/unit-report.test.ts",
      "packages/dsh-provider-usage/test/unit/routes/unit-routes.test.ts",
      "packages/dsh-provider-usage/test/unit/shared/unit-config.test.ts",
      "packages/dsh-provider-usage/test/unit/shared/unit-contract.test.ts",
      "packages/dsh-provider-usage/test/unit/shared/unit-v1.test.ts",
      "packages/dsh-provider-usage/test/unit/trend/unit-trend-ledger.test.ts",
      "packages/dsh-provider-usage/test/unit/trend/unit-trend-view.test.ts",
      "packages/dsh-provider-usage/test/unit/trend/unit-trend.test.ts"
    ]
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-provider-usage-report-schedule.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-provider-usage-report-schedule.json",
  "_comment": "阶段零新段（D17 分层变异）：E3 报告配置/调度面——config+schedule+scheduler+tasks；阶段二（D8）并入 last-run.ts（公共原语）与 report-config-service.ts（配置服务）；testFiles 含 unit-report/unit-report-executor。"
}
