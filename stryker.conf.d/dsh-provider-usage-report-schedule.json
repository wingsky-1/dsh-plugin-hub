{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-provider-usage/src/server/schedule/due.ts",
    "packages/dsh-provider-usage/src/server/schedule/scheduler.ts",
    "packages/dsh-provider-usage/src/server/schedule/tasks.ts",
    "packages/dsh-provider-usage/src/server/schedule/store.ts",
    "packages/dsh-provider-usage/src/server/config/shape.ts",
    "packages/dsh-provider-usage/src/server/config/prompts.ts",
    "packages/dsh-provider-usage/src/server/config/normalize.ts",
    "packages/dsh-provider-usage/src/server/config/store.ts",
    "packages/dsh-provider-usage/src/server/config/service.ts",
    "packages/dsh-provider-usage/src/server/shared/time.ts",
    "packages/dsh-provider-usage/src/server/shared/prompts.ts",
    "packages/dsh-provider-usage/src/server/shared/last-run.ts",
    "!packages/dsh-provider-usage/src/client/**",
    "!packages/dsh-provider-usage/src/**/interface.ts",
    "!packages/dsh-provider-usage/src/server/*/deps.ts",
    "!packages/dsh-provider-usage/src/**/*.d.mts",
    "!packages/dsh-provider-usage/src/server/adapters/deepseek-official.mjs",
    "!packages/dsh-provider-usage/src/server/adapters/opencode-go.mjs",
    "!packages/dsh-provider-usage/src/server/adapters/zai-coding-cn.mjs"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-provider-usage.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-provider-usage-report-schedule.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-provider-usage-report-schedule.json",
  "_comment": "阶段零新段（D17 分层变异）：E3 报告调度面——schedule+scheduler+tasks；阶段二（D8）并入 last-run.ts（公共原语）；#768 D1 起配置面归 server/config 域（shape/prompts/normalize/store/service）；#768 D2 起调度面整域归 server/schedule（due/scheduler/tasks/store，domain2/schedule 与 common/last-run 旧址删除，interface.ts/deps.ts 以 facade/type-only 口径排除）；testFiles 含 unit-report/unit-report-executor + test/integration/schedule/composition-root（串行锁与门面装配判据）。"
}
