{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-jev-decide/src/**/*.ts"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-jev-decide.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-jev-decide.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-jev-decide.json",
  "_comment": "feat/jev-decide 首登：src/**/*.ts 单段覆盖宿主与客户端（域拆分待后续按域重写时再分段）；测试全套跑（perTest 关联）；incremental 基线随 observe 夜间全量班重建。"
}
