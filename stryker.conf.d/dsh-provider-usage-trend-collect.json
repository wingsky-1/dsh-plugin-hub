{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-provider-usage/src/domain2/collect/collector.ts",
    "packages/dsh-provider-usage/src/domain2/collect/types.ts",
    "!packages/dsh-provider-usage/src/client/**",
    "!packages/dsh-provider-usage/src/types.ts"
  ],
  "testRunner": "tap",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/tap-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "tap": {
    "nodeArgs": [
      "-r",
      "./scripts/test/mutation-tap-bridge.cjs",
      "--import",
      "./scripts/test/mutation-lib-to-src-hook.mjs"
    ],
    "testFiles": [
      "packages/dsh-provider-usage/test/**/*.test.ts"
    ]
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-provider-usage-trend-collect.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-provider-usage-trend-collect.json",
  "_comment": "阶段零新段（D17 分层变异）：E1 事件采集面——collector+types（折叠状态机/归属归一）；testFiles 含 unit-trend（杀灭面为该层测试）。"
}
