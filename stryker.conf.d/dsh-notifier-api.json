{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-notifier/src/server/api/**/*.ts",
    "!packages/dsh-notifier/src/client/**",
    "!packages/dsh-notifier/src/**/interface.ts",
    "!packages/dsh-notifier/src/server/*/deps.ts",
    "!packages/dsh-notifier/src/server/channels/impl/system/deps.ts",
    "!packages/dsh-notifier/src/**/*.d.ts",
    "!packages/dsh-notifier/src/**/*.ps1"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-notifier.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-notifier-api.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-notifier-api.json",
  "_comment": "#733 按域重写：api——HTTP 端点域（journal/kinds/probe/route/service/settings/stream）。loopback 围栏在 route 块内，端点自身只做「解析请求 → 调 pipeline/sdk 端口 → 序列化响应」，不含业务裁决。"
}
