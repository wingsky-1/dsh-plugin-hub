{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-provider-usage/src/domain1/routes/stats.ts",
    "packages/dsh-provider-usage/src/domain1/routes/adapters.ts",
    "packages/dsh-provider-usage/src/domain2/routes/ui.ts",
    "packages/dsh-provider-usage/src/domain2/routes/reports.ts",
    "!packages/dsh-provider-usage/src/client/**",
    "!packages/dsh-provider-usage/src/types.ts",
    "!packages/dsh-provider-usage/src/**/interface.ts",
    "!packages/dsh-provider-usage/src/**/*.d.mts",
    "!packages/dsh-provider-usage/src/domain1/adapters/deepseek-official.mjs",
    "!packages/dsh-provider-usage/src/domain1/adapters/opencode-go.mjs",
    "!packages/dsh-provider-usage/src/domain1/adapters/zai-coding-cn.mjs",
    "!packages/dsh-provider-usage/src/shared/placement-math.ts"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-provider-usage.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-provider-usage-routes.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-provider-usage-routes.json",
  "_comment": "阶段一新段（评审 P1-5 前置）：E5/C6 路由面——stats+adapters+ui+reports；先抽纯函数（clampTrendN/isReportPeriodValid/isReportKeyValid/isTaskIdValid）补 unit-routes 再开段；testFiles 含 unit-routes/unit-report/unit-apply。"
}
