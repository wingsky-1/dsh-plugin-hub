{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-provider-usage/src/domain1/registry/registry.ts",
    "packages/dsh-provider-usage/src/domain1/registry/user-adapter-loader.ts",
    "!packages/dsh-provider-usage/src/client/**",
    "!packages/dsh-provider-usage/src/types.ts",
    "!packages/dsh-provider-usage/src/**/interface.ts",
    "!packages/dsh-provider-usage/src/**/*.d.mts",
    "!packages/dsh-provider-usage/src/domain1/adapters/deepseek-official.mjs",
    "!packages/dsh-provider-usage/src/domain1/adapters/opencode-go.mjs",
    "!packages/dsh-provider-usage/src/domain1/adapters/zai-coding-cn.mjs",
    "!packages/dsh-provider-usage/src/shared/placement-math.ts"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-provider-usage.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-provider-usage-registry.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-provider-usage-registry.json",
  "_comment": "#342 二期：功能命名段（registry）——registry+user-adapter-loader（注册表域，25s；阶段零补 loader 盲区）；测试全套跑（perTest 关联）；incremental 基线随 observe 四班次重建。"
}
