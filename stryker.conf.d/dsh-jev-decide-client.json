{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-jev-decide/src/client/**/*.ts",
    "!packages/dsh-jev-decide/src/client/components/atoms.ts"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-jev-decide.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-jev-decide-client.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-jev-decide-client.json",
  "_comment": "按域分段（对标 lan-proxy client 段）：客户端全区；components/atoms.ts 纯样式原子（el/clear/setText/输入框/按钮/徽章/折叠/fmtTime，无分支语义）移出变异面，对标 lan-proxy client 段的 .d.ts/tsx 排除口径；panes 交互、probability 概率条、api/contract 解析保留在面内；面文件集与单段时代一致，仅执行分片变化；测试全套跑（perTest 关联）；incremental 基线随 observe 夜间全量班重建。"
}
