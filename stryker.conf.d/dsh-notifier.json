{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-notifier/src/**/*.ts",
    "!packages/dsh-notifier/src/client/**",
    "!packages/dsh-notifier/src/types.ts"
  ],
  "testRunner": "tap",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/tap-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "tap": {
    "nodeArgs": [
      "-r",
      "./scripts/test/mutation-tap-bridge.cjs"
    ],
    "testFiles": [
      "packages/dsh-notifier/test/unit-text.test.ts",
      "packages/dsh-notifier/test/unit-sanitize.test.ts",
      "packages/dsh-notifier/test/e2e-approval.test.ts",
      "packages/dsh-notifier/test/e2e-done.test.ts",
      "packages/dsh-notifier/test/e2e-question-turn.test.ts"
    ]
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-notifier.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-notifier.json",
  "_comment": "#276 方案 A：src 级单段（mutate 直指 src，文件 glob 声明，无行号无漂移）；测试经 src 入口加载插桩代码；incremental 基线随 observe 四班次重建。"
}
