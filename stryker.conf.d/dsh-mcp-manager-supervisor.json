{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-mcp-manager/src/server/connection/runtime/supervisor.ts",
    "packages/dsh-mcp-manager/src/server/connection/runtime/reconnect.ts",
    "packages/dsh-mcp-manager/src/server/store/**/*.ts",
    "packages/dsh-mcp-manager/src/server/stats/**/*.ts",
    "!packages/dsh-mcp-manager/src/client/**",
    "!packages/dsh-mcp-manager/src/types/**",
    "!packages/dsh-mcp-manager/src/integration/**",
    "!packages/dsh-mcp-manager/src/shared/placement-math.ts",
    "!packages/dsh-mcp-manager/src/**/interface.ts",
    "!packages/dsh-mcp-manager/src/server/*/deps.ts",
    "!packages/dsh-mcp-manager/src/server/connection/runtime/deps.ts"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-mcp-manager.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-mcp-manager-supervisor.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-mcp-manager-supervisor.json",
  "_comment": "#664 阶段6重画：supervisor——连接监督器（runtime/supervisor+reconnect）+状态持久化（config/store，原 middleware-state/store 迁入）+统计（stats）；types/integration（type-only）与 placement-math.ts 显式排除；测试全套跑（perTest 关联）；incremental 基线随 observe 夜间全量班重建（D7 迁移豁免）。"
}
