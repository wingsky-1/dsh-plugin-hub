{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-notifier/src/index.ts",
    "packages/dsh-notifier/src/server/sdk/**/*.ts",
    "!packages/dsh-notifier/src/client/**",
    "!packages/dsh-notifier/src/**/interface.ts",
    "!packages/dsh-notifier/src/server/*/deps.ts",
    "!packages/dsh-notifier/src/server/channels/impl/system/deps.ts",
    "!packages/dsh-notifier/src/**/*.d.ts",
    "!packages/dsh-notifier/src/**/*.ps1"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-notifier-sdk.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-notifier-sdk.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-notifier-sdk.json",
  "_comment": "#733 按域重写：sdk——服务面（registry 动态 kind 注册，service 对外 send/kinds，apiVersion 2）+ 根 index.ts 组合根并入（沿用 #669「装配层归服务面」口径：组合根单文件独立成段可杀性低、dry run 成本照付）。#733 收敛：wingsky-notify/sent 事件与 registerChannel 退役，send 返回 Promise<void>。"
}
