{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-notifier/src/server/stores/**/*.ts",
    "!packages/dsh-notifier/src/client/**",
    "!packages/dsh-notifier/src/types.ts",
    "!packages/dsh-notifier/src/**/interface.ts",
    "!packages/dsh-notifier/src/server/*/deps.ts",
    "!packages/dsh-notifier/src/server/channels/impl/system/deps.ts",
    "!packages/dsh-notifier/src/**/*.d.ts",
    "!packages/dsh-notifier/src/**/*.ps1"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-notifier.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-notifier-stores.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-notifier-stores.json",
  "_comment": "#733 按域重写：stores——存储域（history 串行写队列与按行滚动；status 内存镜像与防抖落盘、LRU 上限）。"
}
