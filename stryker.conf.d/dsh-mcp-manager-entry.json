{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-mcp-manager/src/index.ts",
    "packages/dsh-mcp-manager/src/server/workspace/**/*.ts",
    "packages/dsh-mcp-manager/src/server/config/**/*.ts",
    "!packages/dsh-mcp-manager/src/client/**",
    "!packages/dsh-mcp-manager/src/**/interface.ts",
    "!packages/dsh-mcp-manager/src/server/*/deps.ts",
    "!packages/dsh-mcp-manager/src/server/*/*/deps.ts"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-mcp-manager.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-mcp-manager-entry.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-mcp-manager-entry.json",
  "_comment": "#767 B2b 重画：entry——组合根 src/index.ts + workspace（工作空间解析域）+ config（归一化/导入/schema）；B2b 后文件归各域段，本段只留这三处。W11b2a 删除 src/types 与 src/integration 后，原 types/integration 两条排除已是 0 命中死条目，随本刀删除；excludes 仅保留 client 一条（另一端）。测试全套跑（perTest 关联）；incremental 基线随 observe 夜间全量班重建（D7 迁移豁免）。"
}
