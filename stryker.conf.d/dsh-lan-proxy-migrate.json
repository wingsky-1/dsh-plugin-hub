{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-lan-proxy/src/server/migrate/impl/file/index.ts",
    "packages/dsh-lan-proxy/src/server/migrate/impl/layout/index.ts",
    "packages/dsh-lan-proxy/src/server/migrate/impl/legacy-settings/index.ts",
    "!packages/dsh-lan-proxy/src/client/**",
    "!packages/dsh-lan-proxy/src/**/interface.ts",
    "!packages/dsh-lan-proxy/src/**/deps.ts"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-lan-proxy-migrate.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-lan-proxy-migrate.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-lan-proxy-migrate.json",
  "_comment": "#826 域归位：migrate 域（原根 migrate.ts，一次性 config.json 收编）；门面按 facade 口径进 coverageExcludes；测试按段 testFiles 清单跑（perTest 关联）；incremental 基线随 observe 夜间全量班重建（D7 迁移豁免）。"
}
