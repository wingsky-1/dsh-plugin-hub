{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-notifier/src/server/channels/**/*.ts",
    "packages/dsh-notifier/src/shared/tones.ts",
    "!packages/dsh-notifier/src/client/**",
    "!packages/dsh-notifier/src/types.ts",
    "!packages/dsh-notifier/src/**/interface.ts",
    "!packages/dsh-notifier/src/**/deps.ts",
    "!packages/dsh-notifier/src/**/*.d.ts",
    "!packages/dsh-notifier/src/**/*.ps1"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-notifier.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-notifier-channels.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-notifier-channels.json",
  "_comment": "#733 按域重写：channels——出口域（bark/browser/system/webhook 四出口 + deliver 共享投递阶段与 caps 截断；tones 为系统音色表）。边界：出口只回答「本次失败可不可重试」（DeliverResult.retryable），重试/退避/节流/在途上限一律不在本域，归 pipeline/impl/dispatch。#783 起音色事实源（含三平台素材字段）迁到 src/shared/tones.ts 由两端共用，随本域一起度量：该文件里可变异的是 candidateNames 的平台翻译分支，纯数据字面量由 sharedDefaults.excludedMutations 排除（ObjectLiteral/ArrayLiteral/StringLiteral）。"
}
