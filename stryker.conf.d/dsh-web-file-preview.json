{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-web-file-preview/src/**/*.ts",
    "!packages/dsh-web-file-preview/src/client/**",
    "!packages/dsh-web-file-preview/src/types.ts"
  ],
  "testRunner": "tap",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/tap-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "tap": {
    "nodeArgs": [
      "-r",
      "./scripts/test/mutation-tap-bridge.cjs",
      "--import",
      "./scripts/test/mutation-lib-to-src-hook.mjs"
    ],
    "testFiles": [
      "packages/dsh-web-file-preview/test/unit-grouping.test.ts",
      "packages/dsh-web-file-preview/test/unit-link-resolver.test.ts",
      "packages/dsh-web-file-preview/test/unit-relpath.test.ts",
      "packages/dsh-web-file-preview/test/unit-routes.test.ts",
      "packages/dsh-web-file-preview/test/unit-serve-tokens.test.ts",
      "packages/dsh-web-file-preview/test/unit-basename-fallback.test.ts",
      "packages/dsh-web-file-preview/test/unit-git.test.ts"
    ]
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-web-file-preview.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-web-file-preview.json",
  "_comment": "#276 方案 A：src 级单段（mutate 直指 src，文件 glob 声明，无行号无漂移）；测试经 src 入口加载插桩代码；incremental 基线随 observe 四班次重建。"
}
