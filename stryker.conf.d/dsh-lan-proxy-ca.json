{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-lan-proxy/src/server/ca/impl/*.ts",
    "!packages/dsh-lan-proxy/src/client/**",
    "!packages/dsh-lan-proxy/src/**/interface.ts",
    "!packages/dsh-lan-proxy/src/**/deps.ts"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-lan-proxy-ca.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-lan-proxy-ca.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-lan-proxy-ca.json",
  "_comment": "#930 新域：一键生成本地 CA（三态判定 state.ts + POST 动作 actions.ts；forge 签发纯函数归 tls 域）。门面按 facade 口径进 coverageExcludes；测试按段 testFiles 清单跑（perTest 关联）；incremental 基线随 observe 夜间全量班重建（D7 迁移豁免）。"
}
