{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-notifier/src/message.ts",
    "!packages/dsh-notifier/src/client/**",
    "!packages/dsh-notifier/src/types.ts"
  ],
  "testRunner": "tap",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/tap-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "tap": {
    "nodeArgs": [
      "-r",
      "./scripts/test/mutation-tap-bridge.cjs",
      "--import",
      "./scripts/test/mutation-lib-to-src-hook.mjs"
    ],
    "testFiles": [
      "packages/dsh-notifier/test/e2e-approval.test.ts",
      "packages/dsh-notifier/test/e2e-done.test.ts",
      "packages/dsh-notifier/test/e2e-edge.test.ts",
      "packages/dsh-notifier/test/e2e-question-turn.test.ts",
      "packages/dsh-notifier/test/migration.test.ts",
      "packages/dsh-notifier/test/routes.test.ts",
      "packages/dsh-notifier/test/unit-config.test.ts",
      "packages/dsh-notifier/test/unit-sanitize.test.ts",
      "packages/dsh-notifier/test/unit-text.test.ts"
    ]
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-notifier-message.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-notifier-message.json",
  "_comment": "#342 二期：功能命名段（message）——message.ts 单文件（145s 全量，per-mutant 成本主导的物理极限，维持现状）；测试全套跑（perTest 关联）；incremental 基线随 observe 四班次重建。"
}
