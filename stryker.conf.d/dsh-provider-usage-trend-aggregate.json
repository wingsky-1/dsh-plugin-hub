{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-provider-usage/src/domain2/aggregate/aggregator.ts",
    "packages/dsh-provider-usage/src/domain2/aggregate/aggregate-rows.ts",
    "packages/dsh-provider-usage/src/domain2/aggregate/aggregate-query.ts",
    "packages/dsh-provider-usage/src/domain2/aggregate/store.ts",
    "packages/dsh-provider-usage/src/domain2/aggregate/index.ts",
    "!packages/dsh-provider-usage/src/client/**",
    "!packages/dsh-provider-usage/src/types.ts",
    "!packages/dsh-provider-usage/src/**/interface.ts",
    "!packages/dsh-provider-usage/src/**/*.d.mts",
    "!packages/dsh-provider-usage/src/domain1/adapters/deepseek-official.mjs",
    "!packages/dsh-provider-usage/src/domain1/adapters/opencode-go.mjs",
    "!packages/dsh-provider-usage/src/domain1/adapters/zai-coding-cn.mjs",
    "!packages/dsh-provider-usage/src/shared/placement-math.ts"
  ],
  "testRunner": "vitest",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "vitest": {
    "related": false,
    "configFile": "vitest.stryker.d/dsh-provider-usage.config.ts"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-provider-usage-trend-aggregate.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-provider-usage-trend-aggregate.json",
  "_comment": "阶段零新段（D17 分层变异）：E2 聚合/压实/存储面——aggregator+store+index；阶段三（#670 D2）aggregator 拆分为 aggregate-rows（压实转换纯函数）+ aggregate-query（查询投影纯函数），两新文件并入 mutate 面（防新文件变异盲区）；testFiles 含 unit-trend/unit-trend-ledger/unit-trend-view（杀灭面为该层测试，R8 台账守恒断言覆盖守恒链）；aggregator 单文件 5-8 分钟，独立段防超时。"
}
