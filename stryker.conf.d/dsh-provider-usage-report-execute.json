{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "packages/dsh-provider-usage/src/report/runner.ts",
    "packages/dsh-provider-usage/src/report/generate.ts",
    "packages/dsh-provider-usage/src/report/format.ts",
    "!packages/dsh-provider-usage/src/client/**",
    "!packages/dsh-provider-usage/src/types.ts"
  ],
  "testRunner": "tap",
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ArrayLiteral",
      "ObjectLiteral",
      "TemplateLiteral"
    ]
  },
  "plugins": [
    "@stryker-mutator/tap-runner"
  ],
  "concurrency": 16,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 5,
  "reporters": [
    "progress",
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "tap": {
    "nodeArgs": [
      "-r",
      "./scripts/test/mutation-tap-bridge.cjs",
      "--import",
      "./scripts/test/mutation-lib-to-src-hook.mjs"
    ],
    "testFiles": [
      "packages/dsh-provider-usage/test/unit-apply.test.ts",
      "packages/dsh-provider-usage/test/unit-config.test.ts",
      "packages/dsh-provider-usage/test/unit-contract.test.ts",
      "packages/dsh-provider-usage/test/unit-deepseek-official.test.ts",
      "packages/dsh-provider-usage/test/unit-history.test.ts",
      "packages/dsh-provider-usage/test/unit-signal-lock.test.ts",
      "packages/dsh-provider-usage/test/unit-v1.test.ts",
      "packages/dsh-provider-usage/test/unit-trend.test.ts",
      "packages/dsh-provider-usage/test/unit-trend-view.test.ts",
      "packages/dsh-provider-usage/test/unit-report.test.ts"
    ]
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/dsh-provider-usage-report-execute.json"
  },
  "incremental": true,
  "incrementalFile": "coverage/mutation/incremental-provider-usage-report-execute.json",
  "_comment": "阶段零新段（D17 分层变异）：E4 报告执行/产出面——runner+generate+format；testFiles 含 unit-report（杀灭面为该层测试）。"
}
