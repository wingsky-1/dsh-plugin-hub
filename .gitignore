# 依赖与构建产物
node_modules/
.pnpm-store/
dist/
*.tsbuildinfo
*.log

# 构建产物（源码在 src/，发布内容由构建生成（tsc + bundle-host），不入库）
packages/*/lib/
packages/*/shared/
packages/*/types/
packages/*/LICENSE
packages/*/.index.bundle.js

# 仓库根 shared/ 的构建产物（#1028 后续：shared 已 TS 化，声明由 tsc 产出、原地 emit，
# 故 *.js / *.d.ts / *.map 与 *.ts 源码同目录。版本库里 shared/ 只允许有 .ts 源码，
# 回归由 scripts/test/shared-ts-shape.test.ts 冻结守卫判红）
shared/*.js
shared/*.d.ts
shared/*.js.map
shared/client/*.js
shared/client/*.d.ts
shared/client/*.js.map

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
coverage/
.stryker-tmp/
.maintenance-drafts/
.catalog-peers.lock
packages/*/package.json.catalog-sync-*.tmp

# codegraph 本地索引（每 worktree 独立，不入库；任务结束随目录清理）
.codegraph/

# 测试运行时污染兜底（#218）：DSH_HOME 未正确注入时产生的 undefined 路径与历史数据
packages/*/undefined/
**/*.jsonl

# health-report 运行时产物（#718 复核 F5）：那几个步骤在仓库根落盘，本地手工复跑会留下
