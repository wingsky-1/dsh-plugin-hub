# 依赖与构建产物
node_modules/
.pnpm-store/
dist/
*.tsbuildinfo
*.log

# 构建产物（源码在 src/，发布内容由构建生成（tsc + bundle-host），不入库）
packages/*/lib/
packages/*/shared/
packages/*/types/
packages/*/LICENSE
packages/*/.index.bundle.js

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
coverage/
.stryker-tmp/
.maintenance-drafts/

# codegraph 本地索引（每 worktree 独立，不入库；任务结束随目录清理）
.codegraph/

# 测试运行时污染兜底（#218）：DSH_HOME 未正确注入时产生的 undefined 路径与历史数据
packages/*/undefined/
**/*.jsonl
